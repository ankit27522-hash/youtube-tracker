# Server Port
PORT=5000

# Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Secret key for signing JWT authentication tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_12345

# Token expiration time
JWT_EXPIRES_IN=7d

# MongoDB Connection String (Optional: leave empty to use built-in local persistent storage)
# Example for local MongoDB: mongodb://localhost:27017/youtube_tracker
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/youtube_tracker?retryWrites=true&w=majority
MONGODB_URI=

# Official YouTube Data API v3 Key
# Get a free key from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on your project
YOUTUBE_API_KEY=
